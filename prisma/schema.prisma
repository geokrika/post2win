generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bets {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file_id        String?     @db.Uuid
  user_id        String?     @db.Uuid
  amount         Decimal     @db.Decimal(10, 2)
  tickets_earned BigInt
  created_at     DateTime?   @default(now()) @db.Timestamptz(6)
  user_files     user_files? @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model draw_rounds {
  id                    Int          @id @default(autoincrement())
  status                String?      @default("ACTIVE") @db.VarChar(20)
  seed_amount           Decimal?     @default(100.00) @db.Decimal(12, 2)
  current_jackpot       Decimal?     @default(100.00) @db.Decimal(12, 2)
  starts_at             DateTime?    @default(now()) @db.Timestamptz(6)
  ends_at               DateTime     @db.Timestamptz(6)
  winning_file_id       String?      @db.Uuid
  winning_ticket_number BigInt?
  winning_seed_hash     String?      @db.VarChar(255)
  user_files            user_files[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_files {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id     Int?
  user_id      String?      @db.Uuid
  hash_id      String       @default(uuid())
  media_type   String       @db.VarChar(10)
  file_url     String?
  text_content String?
  display_as   String       @default("USERNAME") @db.VarChar(10)
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  bets         bets[]
  draw_rounds  draw_rounds? @relation(fields: [round_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  votes        votes[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id                String       @unique @db.VarChar(20)
  email                    String       @unique @db.VarChar(255)
  phone_number             String?      @unique @db.VarChar(20)
  password_hash            String       @db.VarChar(255)
  full_name                String       @db.VarChar(100)
  username                 String       @unique @db.VarChar(50)
  default_display_identity String?      @default("username") @db.VarChar(10)
  wallet_balance           Decimal?     @default(0.00) @db.Decimal(12, 2)
  is_verified              Boolean?     @default(false)
  created_at               DateTime?    @default(now()) @db.Timestamptz(6)
  bets                     bets[]
  user_files               user_files[]
  votes                    votes[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model votes {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file_id        String?     @db.Uuid
  voter_user_id  String?     @db.Uuid
  amount         Decimal     @db.Decimal(10, 2)
  tickets_earned BigInt
  created_at     DateTime?   @default(now()) @db.Timestamptz(6)
  user_files     user_files? @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?      @relation(fields: [voter_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model platform_fees {
  id          String   @id @default(uuid())
  amount      Decimal  @db.Decimal(12, 2)
  source_type String   @default("BET_FEE")
  created_at  DateTime @default(now())
}
